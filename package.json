{
  "name": "heirs-idle-rpg",
  "private": true,
  "version": "0.1.0",
  "description": "계승자들 - 가문을 이어가는 픽셀 방치형 RPG",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:single": "vite build -c vite.single.config.ts",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "build:release": "VITE_RELEASE=true vite build"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "galmuri": "2.40.3",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "5.1.0"
  }
}
